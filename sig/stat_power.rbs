module StatPower
  VERSION: String

  class Error < StandardError
  end

  class DomainError < Error
  end

  class ConvergenceError < Error
  end

  class Result
    attr_reader sample_size: Integer?
    attr_reader power: Float?
    attr_reader effect_size: Float?
    attr_reader alpha: Float?

    def initialize: (
      sample_size: Integer?,
      power: Float?,
      effect_size: Float?,
      alpha: Float?
    ) -> void
  end

  class PowerResult
    attr_reader sample_size: Float
    attr_reader power: Float
    attr_reader effect_size: Float
    attr_reader alpha: Float
    attr_reader alternative: Symbol
    attr_reader analysis_method: String

    def initialize: (
      sample_size: Float,
      power: Float,
      effect_size: Float,
      alpha: Float,
      alternative: Symbol,
      analysis_method: String
    ) -> void

    def required_sample_size: () -> Integer
  end

  class UnequalPowerResult
    attr_reader sample_size1: Float
    attr_reader sample_size2: Float
    attr_reader power: Float
    attr_reader effect_size: Float
    attr_reader alpha: Float
    attr_reader alternative: Symbol
    attr_reader analysis_method: String

    def initialize: (
      sample_size1: Float,
      sample_size2: Float,
      power: Float,
      effect_size: Float,
      alpha: Float,
      alternative: Symbol,
      analysis_method: String
    ) -> void

    def required_sample_size1: () -> Integer
    def required_sample_size2: () -> Integer
    def total_sample_size: () -> Float
    def required_total_sample_size: () -> Integer
  end

  class AnovaResult
    attr_reader groups: Float
    attr_reader sample_size: Float
    attr_reader power: Float
    attr_reader effect_size: Float
    attr_reader alpha: Float
    attr_reader analysis_method: String

    def initialize: (
      groups: Float,
      sample_size: Float,
      power: Float,
      effect_size: Float,
      alpha: Float,
      analysis_method: String
    ) -> void

    def required_groups: () -> Integer
    def required_sample_size: () -> Integer
    def total_sample_size: () -> Float
    def required_total_sample_size: () -> Integer
  end

  class F2Result
    attr_reader numerator_df: Float
    attr_reader denominator_df: Float
    attr_reader power: Float
    attr_reader effect_size: Float
    attr_reader alpha: Float
    attr_reader analysis_method: String

    def initialize: (
      numerator_df: Float,
      denominator_df: Float,
      power: Float,
      effect_size: Float,
      alpha: Float,
      analysis_method: String
    ) -> void

    def total_sample_size: () -> Float
    def required_total_sample_size: () -> Integer
  end

  class ChiSquareResult
    attr_reader degrees_of_freedom: Float
    attr_reader sample_size: Float
    attr_reader power: Float
    attr_reader effect_size: Float
    attr_reader alpha: Float
    attr_reader analysis_method: String

    def initialize: (
      degrees_of_freedom: Float,
      sample_size: Float,
      power: Float,
      effect_size: Float,
      alpha: Float,
      analysis_method: String
    ) -> void

    def required_sample_size: () -> Integer
  end

  class PowerCurvePoint
    attr_reader sample_size: Float
    attr_reader power: Float

    def initialize: (
      sample_size: Float,
      power: Float
    ) -> void
  end

  module EffectSize
    module Conventional
      def self.resolve: (test: Symbol | String, size: Symbol | String) -> Float
    end

    module Proportion
      def self.cohen_h: (p1: Numeric, p2: Numeric) -> Float
    end

    module ChiSquare
      def self.goodness_of_fit: (
        null_probabilities: Array[Numeric],
        alternative_probabilities: Array[Numeric]
      ) -> Float

      def self.association: (
        probabilities: Array[Array[Numeric]]
      ) -> Float
    end
  end

  module NormalMean
    def self.solve: (
      ?effect_size: Numeric | Symbol | String | nil,
      ?sample_size: Numeric | nil,
      ?alpha: Numeric | nil,
      ?power: Numeric | nil,
      ?alternative: Symbol | String
    ) -> PowerResult
  end

  module Proportion
    def self.one_sample: (
      ?effect_size: Numeric | Symbol | String | nil,
      ?sample_size: Numeric | nil,
      ?alpha: Numeric | nil,
      ?power: Numeric | nil,
      ?alternative: Symbol | String
    ) -> PowerResult

    def self.two_sample: (
      ?effect_size: Numeric | Symbol | String | nil,
      ?sample_size: Numeric | nil,
      ?alpha: Numeric | nil,
      ?power: Numeric | nil,
      ?alternative: Symbol | String
    ) -> PowerResult

    def self.two_sample_unequal: (
      ?effect_size: Numeric | Symbol | String | nil,
      ?sample_size1: Numeric | nil,
      ?sample_size2: Numeric | nil,
      ?alpha: Numeric | nil,
      ?power: Numeric | nil,
      ?alternative: Symbol | String
    ) -> UnequalPowerResult
  end

  module TTest
    def self.one_sample: (
      ?effect_size: Numeric | Symbol | String | nil,
      ?sample_size: Numeric | nil,
      ?alpha: Numeric | nil,
      ?power: Numeric | nil,
      ?alternative: Symbol | String
    ) -> PowerResult

    def self.paired: (
      ?effect_size: Numeric | Symbol | String | nil,
      ?sample_size: Numeric | nil,
      ?alpha: Numeric | nil,
      ?power: Numeric | nil,
      ?alternative: Symbol | String
    ) -> PowerResult

    def self.two_sample: (
      ?effect_size: Numeric | Symbol | String | nil,
      ?sample_size: Numeric | nil,
      ?alpha: Numeric | nil,
      ?power: Numeric | nil,
      ?alternative: Symbol | String
    ) -> PowerResult

    def self.two_sample_unequal: (
      ?effect_size: Numeric | Symbol | String | nil,
      ?sample_size1: Numeric | nil,
      ?sample_size2: Numeric | nil,
      ?alpha: Numeric | nil,
      ?power: Numeric | nil,
      ?alternative: Symbol | String
    ) -> UnequalPowerResult
  end

  module Correlation
    def self.solve: (
      ?correlation: Numeric | Symbol | String | nil,
      ?sample_size: Numeric | nil,
      ?alpha: Numeric | nil,
      ?power: Numeric | nil,
      ?alternative: Symbol | String
    ) -> PowerResult
  end

  module Anova
    def self.solve: (
      ?groups: Numeric | nil,
      ?sample_size: Numeric | nil,
      ?effect_size: Numeric | Symbol | String | nil,
      ?alpha: Numeric | nil,
      ?power: Numeric | nil
    ) -> AnovaResult
  end

  module F2
    def self.solve: (
      ?numerator_df: Numeric | nil,
      ?denominator_df: Numeric | nil,
      ?effect_size: Numeric | Symbol | String | nil,
      ?alpha: Numeric | nil,
      ?power: Numeric | nil
    ) -> F2Result
  end

  module ChiSquare
    def self.solve: (
      degrees_of_freedom: Numeric,
      ?effect_size: Numeric | Symbol | String | nil,
      ?sample_size: Numeric | nil,
      ?alpha: Numeric | nil,
      ?power: Numeric | nil
    ) -> ChiSquareResult
  end

  module PowerCurve
    def self.generate: (
      sample_sizes: Enumerable[Numeric]
    ) { (Float) -> (Numeric | PowerResult | UnequalPowerResult | AnovaResult | F2Result | ChiSquareResult) } -> Array[PowerCurvePoint]
  end

  module SpecialFunctions
    module Beta
      def self.regularized: (Numeric x, a: Numeric, b: Numeric) -> Float
    end

    module Gamma
      def self.regularized_lower: (a: Numeric, x: Numeric) -> Float
      def self.regularized_upper: (a: Numeric, x: Numeric) -> Float
    end
  end

  module Integration
    module AdaptiveSimpson
      def self.integrate: (
        lower: Numeric,
        upper: Numeric,
        ?tolerance: Numeric,
        ?max_depth: Integer
      ) { (Float) -> Numeric } -> Float
    end
  end

  module Distributions
    module Normal
      def self.pdf: (Numeric x) -> Float
      def self.cdf: (Numeric x) -> Float
      def self.survival: (Numeric x) -> Float
      def self.quantile: (Numeric probability) -> Float
    end

    module StudentT
      def self.pdf: (Numeric x, degrees_of_freedom: Numeric) -> Float
      def self.cdf: (Numeric x, degrees_of_freedom: Numeric) -> Float
      def self.survival: (Numeric x, degrees_of_freedom: Numeric) -> Float
      def self.quantile: (Numeric probability, degrees_of_freedom: Numeric) -> Float
    end

    module NoncentralT
      def self.cdf: (
        Numeric x,
        degrees_of_freedom: Numeric,
        noncentrality: Numeric
      ) -> Float

      def self.survival: (
        Numeric x,
        degrees_of_freedom: Numeric,
        noncentrality: Numeric
      ) -> Float
    end

    module FDistribution
      def self.pdf: (
        Numeric x,
        numerator_df: Numeric,
        denominator_df: Numeric
      ) -> Float

      def self.cdf: (
        Numeric x,
        numerator_df: Numeric,
        denominator_df: Numeric
      ) -> Float

      def self.survival: (
        Numeric x,
        numerator_df: Numeric,
        denominator_df: Numeric
      ) -> Float

      def self.quantile: (
        Numeric probability,
        numerator_df: Numeric,
        denominator_df: Numeric
      ) -> Float
    end

    module NoncentralF
      def self.cdf: (
        Numeric x,
        numerator_df: Numeric,
        denominator_df: Numeric,
        noncentrality: Numeric
      ) -> Float

      def self.survival: (
        Numeric x,
        numerator_df: Numeric,
        denominator_df: Numeric,
        noncentrality: Numeric
      ) -> Float
    end

    module ChiSquare
      def self.pdf: (Numeric x, degrees_of_freedom: Numeric) -> Float
      def self.cdf: (Numeric x, degrees_of_freedom: Numeric) -> Float
      def self.survival: (Numeric x, degrees_of_freedom: Numeric) -> Float
      def self.quantile: (Numeric probability, degrees_of_freedom: Numeric) -> Float
    end

    module NoncentralChiSquare
      def self.cdf: (
        Numeric x,
        degrees_of_freedom: Numeric,
        noncentrality: Numeric
      ) -> Float

      def self.survival: (
        Numeric x,
        degrees_of_freedom: Numeric,
        noncentrality: Numeric
      ) -> Float
    end
  end

  module Solvers
    module Bisection
      def self.solve: (
        lower: Numeric,
        upper: Numeric,
        ?absolute_tolerance: Float,
        ?relative_tolerance: Float,
        ?max_iterations: Integer
      ) { (Float) -> Numeric } -> Float
    end
  end
end
